{
  "name": "du-dust",
  "version": "1.2.5",
  "description": "A more intuitive version of du",
  "keywords": [
    "du",
    "command-line",
    "disk",
    "disk-usage"
  ],
  "homepage": "https://github.com/bootandy/dust",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bootandy/dust.git"
  },
  "license": "Apache-2.0",
  "author": "bootandy <bootandy@gmail.com>",
  "contributors": [
    "nebkor <code@ardent.nebcorp.com>"
  ],
  "type": "module",
  "bin": {
    "dust": "./src/main.ts"
  },
  "files": [
    "src",
    "completions",
    "man-page",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc --noEmit && node build.ts",
    "typecheck": "tsc --noEmit",
